<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon: without this, launchers that normalize legacy
     icons (e.g. Nova) shrink the square PNG onto a white tile. The artwork
     lives in the foreground layer, scaled into the 66dp safe zone; the
     background is the icon's own dark navy. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
